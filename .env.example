# Server-only secret, configured in hosting settings. Never commit an actual key.
TOMTOM_API_KEY=

# Optional paid search fallback; disabled by default independently of routing/traffic.
TOMTOM_SEARCH_ENABLED=false

# HERE Routing API v8, server-only; leave unset until the HERE app is configured.
HERE_API_KEY=

# Optional display context; use staging for the staging status banner.
LAPAN_ENVIRONMENT=production

# TomTom remains the default main provider; Valhalla is the secondary provider.
TOMTOM_ROUTING_DISABLED=false

# Optional one-time deployment reset: an ISO UTC timestamp resets older saved
# routing settings to TomTom. Later administrator selections are preserved.
TOMTOM_ROUTING_RESET_AT=

# Optional base URL of a dedicated HTTPS
# Valhalla service. When unset, routing uses the FOSSGIS demo.
VALHALLA_URL=
